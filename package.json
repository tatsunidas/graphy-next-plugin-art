{
  "name": "graphy-next-plugin-art",
  "version": "0.1.0",
  "private": true,
  "description": "Art of Imaging plugin for GRAPHY-Next",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build",
    "thumbs": "python3 tools/fetch-thumbs.py",
    "thumbs:check": "python3 tools/fetch-thumbs.py --self-test"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "esbuild": "^0.23.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
